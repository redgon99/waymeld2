# =============================================
# WayMeld (여로담) env template
# .env 또는 .env.local 에 동일 키를 복사해 사용하세요.
# =============================================

# 지도
VITE_KAKAO_JS_KEY=발급받은_카카오_JavaScript_키
VITE_KAKAO_REST_KEY=
VITE_GOOGLE_MAPS_API_KEY=
# 개발 테스트용: auto | kakao | google
VITE_MAP_PROVIDER_FORCE=auto

# 인증/저장소
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AUTH_GOOGLE_ENABLED=false

# Tour API (한국관광공사 KorService2)
# - 로컬 dev: VITE_TOUR_API_KEY → /api/tour-search Vite 프록시
# - 프로덕션: Supabase Edge Function `tour-search` + secret TOUR_API_KEY
#   supabase secrets set TOUR_API_KEY=발급키
#   supabase functions deploy tour-search
VITE_TOUR_API_KEY=

# 관리자 (선택)
# 예: admin1@domain.com,admin2@domain.com
VITE_ADMIN_EMAILS=

# Plus 구독 (선택) — 결제/포털 URL
VITE_PLUS_CHECKOUT_URL=
VITE_STRIPE_PORTAL_URL=

# 시장 인사이트 (관리자 전용, /admin/insights)
# - 클라이언트 env 아님. 아래는 전부 Supabase Edge Function secret로만 등록:
#   supabase functions deploy insight-collect-youtube insight-collect-naver insight-collect-reddit insight-analyze
#   supabase secrets set YOUTUBE_API_KEY=발급키
#   supabase secrets set NAVER_CLIENT_ID=발급값 NAVER_CLIENT_SECRET=발급값
#   supabase secrets set REDDIT_CLIENT_ID=발급값 REDDIT_CLIENT_SECRET=발급값
#   supabase secrets set ANTHROPIC_API_KEY=발급키
# - YOUTUBE_API_KEY: Google Cloud Console에서 YouTube Data API v3 사용 설정 후 발급
# - NAVER_CLIENT_ID/SECRET: 네이버 개발자센터(https://developers.naver.com) 오픈API 애플리케이션 등록 (검색 API)
# - REDDIT_CLIENT_ID/SECRET: reddit.com/prefs/apps 에서 "script" 타입 앱 생성
# - ANTHROPIC_API_KEY: Claude API 콘솔에서 발급 (수집된 게시글/댓글 분류·요약용)
# - 수집 대상 키워드는 배포 후 /admin/insights UI에서 직접 추가/삭제 (마이그레이션에 기본 시드 포함)
# - 주기 자동 수집을 원하면 Supabase 대시보드에서 pg_cron/pg_net 확장을 켜고
#   위 함수들을 주기적으로 net.http_post 호출하도록 cron.schedule 설정 (선택, 수동 "지금 수집" 버튼으로도 충분히 사용 가능)
#
# YouTube / 웹 링크 → 장소 추출 (플래너 검색 패널)
#   supabase functions deploy link-places-extract
#   (선택) 기존 youtube-places-extract 도 유지 가능
#   시크릿: YOUTUBE_API_KEY (YouTube용), ANTHROPIC_API_KEY (권장)
#   검색창에 YouTube·웹 URL → 장소 추출 / 인스타·틱톡 → 원문 열기·안내