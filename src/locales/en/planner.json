    "expand": "Show more",
    "collapse": "Collapse",
    "details": {
      "esim": {
        "body": "Activate your eSIM before landing, or get connected at a carrier booth in the airport, so you have data right after immigration.",
        "tip1": "Carrier booths in arrivals can activate service instantly",
        "tip2": "eSIMs install via QR code ahead of time — just activate on arrival",
        "tip3": "Pocket Wi-Fi routers can be reserved online and picked up/returned at the airport",
        "links": [
          {
            "label": "Incheon Airport – Roaming Center Info",
            "url": "https://www.airport.kr/ap/ko/svc/getFacilityMain.do?CTGRY_ID=12&UPPER_ID=127"
          }
        ]
      },
      "tmoney": {
        "body": "A prepaid transit card that works on buses, subway, and at convenience stores — much easier than counting cash every ride.",
        "tip1": "Buy one at convenience stores (GS25, CU) or airport kiosks",
        "tip2": "Top up with cash at the same convenience stores",
        "tip3": "Tap on boarding, and tap again when transferring",
        "links": [
          {
            "label": "Tmoney Official Site",
            "url": "https://www.tmoney.co.kr/"
          }
        ]
      },
      "maps": {
        "body": "Google Maps' transit directions are limited in Korea. Install Kakao Map or Naver Map alongside it.",
        "tip1": "Kakao Map — most accurate for transit and walking directions",
        "tip2": "Naver Map — a similar alternative to Kakao Map",
        "tip3": "Use Google Maps as a backup for place search and sharing abroad",
        "links": [
          {
            "label": "Kakao Map",
            "url": "https://map.kakao.com/"
          },
          {
            "label": "Naver Map",
            "url": "https://map.naver.com/"
          },
          {
            "label": "Google Maps",
            "url": "https://maps.google.com/"
          }
        ]
      },
      "airport": {
        "body": "Decide ahead of time whether you'll take the airport railroad (AREX), a limousine bus, or a taxi, based on where your lodging is.",
        "tip1": "AREX express train is the fastest and cheapest option",
        "tip2": "Limousine buses are easier with a lot of luggage, dropping closer to your lodging",
        "tip3": "Save your lodging's address ahead of time to show a taxi driver",
        "links": [
          {
            "label": "Incheon International Airport Corporation",
            "url": "https://www.airport.kr/"
          },
          {
            "label": "AREX Airport Railroad",
            "url": "https://www.arex.or.kr/"
          }
        ]
      },
      "exchange": {
        "body": "Cards are accepted almost everywhere, but traditional markets, some temples, and small taxis may be cash-only.",
        "tip1": "Exchanging a small amount at the airport or a city bank is usually enough",
        "tip2": "Foreign cards can withdraw cash at convenience-store ATMs marked \"Global\"",
        "tip3": "Keep cash on hand for traditional market purchases and temple admission fees",
        "links": [
          {
            "label": "Korea Customs Service – Currency Declaration",
            "url": "https://www.customs.go.kr/kcs/cm/cntnts/cntntsView.do?mi=8458&cntntsId=2808"
          }
        ]
      },
      "emergency": {
        "body": "If something goes wrong during your trip, call one of these numbers right away. 1330 offers multilingual tourist assistance.",
        "tip1": "1330 — tourist information and interpretation (multiple languages)",
        "tip2": "112 — police",
        "tip3": "119 — fire and ambulance",
        "links": [
          {
            "label": "Gov24 – 1330 Tourist Info Line",
            "url": "https://www.gov.kr/portal/service/serviceInfo/B55101100019"
          },
          {
            "label": "112 Police Report Portal",
